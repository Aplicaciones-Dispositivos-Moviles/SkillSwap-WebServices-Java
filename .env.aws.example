# Variables of the AWS server. On the server copy this file to ".env" (cp .env.aws.example .env), fill it in with
# nano and never commit the real one. The values are the ones of the Render dashboard, except the ones marked NEW.

# NEW - the public name of the server (no https://), e.g. skillswap-innovify.duckdns.org
DOMAIN=
# NEW - password of the PostgreSQL container: use only letters and digits (openssl rand -hex 24)
POSTGRES_PASSWORD=

# Public URL of this backend, used in the verification email link (NEW value: https://<DOMAIN>)
APP_VERIFICATION_BASE_URL=
# Public base URL of the shareable credentials (keep the value of Render)
APP_CREDENTIALS_BASE_URL=

# JWT (the same value as in Render keeps the tokens already issued valid)
TOKEN_SETTINGS_SECRET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=

# Emails (Brevo). Empty = the emails are only written to the log
BREVO_API_KEY=
EMAIL_SENDER_ADDRESS=
EMAIL_SENDER_NAME=SkillSwap

# Push notifications: service account JSON in Base64 (empty = only written to the log)
FIREBASE_CREDENTIALS_BASE64=

# Subscriptions: leave REVENUECAT_API_KEY empty to keep the purchases simulated
REVENUECAT_API_KEY=
REVENUECAT_WEBHOOK_AUTH=
REVENUECAT_ENTITLEMENT_ID=premium
REVENUECAT_ACCEPT_SANDBOX=true

CORS_ALLOWED_ORIGINS=
