# Environment variables of the SkillSwap API. Copy the ones you need into your shell, IDE run configuration or the
# Render dashboard. Never commit real values.

# Database (Render gives postgres://user:password@host:5432/db; locally you can set spring.datasource.* instead)
DATABASE_URL=

# JWT (at least 32 characters)
TOKEN_SETTINGS_SECRET=
TOKEN_SETTINGS_EXPIRATION_DAYS=7

# Cloudinary (certificate files)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gemini (assessment questions)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=

# RevenueCat (monthly subscription through Google Play Billing). Leave REVENUECAT_API_KEY empty to SIMULATE the
# purchases locally: nothing is charged and no RevenueCat account is needed.
#   REVENUECAT_API_KEY        secret API key of the project (Project settings > API keys > Secret key, sk_...)
#   REVENUECAT_WEBHOOK_AUTH   the exact value typed in the "Authorization header value" of the webhook
#   REVENUECAT_ENTITLEMENT_ID the entitlement that grants the monthly plan
#   REVENUECAT_ACCEPT_SANDBOX apply the test purchases (environment SANDBOX); set false in production
REVENUECAT_API_KEY=
REVENUECAT_WEBHOOK_AUTH=
REVENUECAT_ENTITLEMENT_ID=premium
REVENUECAT_ACCEPT_SANDBOX=true

# Billing: how often the subscriptions whose period ended are checked, and how long a simulated period lasts
BILLING_EXPIRATION_CHECK_INTERVAL=1h
BILLING_SIMULATED_PERIOD=30d

CORS_ALLOWED_ORIGINS=
